NEXT_PUBLIC_CONTENTFUL_SPACE_ID=
NEXT_PUBLIC_CONTENTFUL_ACCESS_TOKEN=

# Реальный домен сайта — используется в sitemap.xml, robots.txt и
# микроразметке (JSON-LD), чтобы ссылки в них были абсолютными и верными.
# Сейчас сайт на GitHub Pages — переменная закомментирована, поэтому
# используется адрес по умолчанию из lib/site.ts (adilbekzharkyn1988-code.github.io).
# Когда переедете на свой домен — раскомментируйте строку ниже.
# NEXT_PUBLIC_SITE_URL=https://juparfume.kz

# URL Google Apps Script Web App для приёма заявок (заказов) с сайта
# и их чтения в /admin. См. подробную инструкцию по настройке в
# docs/google-apps-script.js
NEXT_PUBLIC_LEADS_ENDPOINT=https://script.google.com/macros/s/AKfycbzusIKrm14Nin76R5VLAIsY0DGs3SasA1wXwOkLm7KHAIhgJBuN6iOasy2VUopHzgS7/exec
